# Created: 2026-09-25 05:39 CEST
# Role: Example configuration for the Solar Template theme's own .env file.
# Author: David ROMERA <d.romera.11@gmail.com>
# Purpose: Document every setting the theme reads from its own .env (never database credentials —
#          those belong to the parent wordpress-dev-env repo's own .env, a separate file in a
#          separate directory, with no naming conflict). Copy this file to `.env` for local use.

# Kept in sync with the `Version:` header of style.css and the `version` field of composer.json
# (see RELEASE.md). Never the source of truth on its own, but exposed for convenience (e.g. to
# display it on the future admin settings screen).
SOLAR_TEMPLATE_VERSION=0.4.7

# "development" enables verbose/dev-friendly asset behaviour (e.g. source maps) once the JS/SCSS
# build pipeline is in place (see the asset pipeline step); "production" is the default otherwise.
SOLAR_TEMPLATE_ASSETS_MODE=production

# Default time-to-live, in seconds, for Solar_Template\Support\TransientCache entries that don't
# specify their own TTL.
SOLAR_TEMPLATE_CACHE_TTL=3600
