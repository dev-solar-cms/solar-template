<?xml version="1.0"?>
<!--
	Created: 2026-09-25 05:39 CEST
	Role: PHP_CodeSniffer ruleset for the Solar Template theme.
	Author: David ROMERA <d.romera.11@gmail.com>
	Purpose: Enforce WordPress coding standards (with the solar-template text domain) on every
	         PHP file of the theme, run via `composer lint` / `composer format`.
-->
<ruleset name="Solar Template">
	<description>Coding standard for the Solar Template WordPress theme.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/dist/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="solar-template"/>
			</property>
		</properties>
	</rule>

	<config name="testVersion" value="8.1-"/>

	<!--
		Tests run as plain PHP CLI via PHPUnit, never inside a loaded WordPress: the
		"use WP_Filesystem/wp_remote_get/wp_delete_file instead" sniffs assume a runtime this
		context doesn't have, so they are scoped out of tests/ only (everything else in this
		ruleset still applies there).
	-->
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_mkdir">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_system_operations_rmdir">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions.unlink_unlink">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
</ruleset>
