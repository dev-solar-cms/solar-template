<?xml version="1.0" encoding="UTF-8"?>
<!--
	Created: 2026-09-25 05:39 CEST
	Role: PHPUnit configuration for the Solar Template theme.
	Author: David ROMERA <d.romera.11@gmail.com>
	Purpose: Run the theme's PHP unit tests (tests/php/*) with a lightweight bootstrap that stubs
	         only the handful of WordPress functions/constants actually exercised outside of a
	         real WordPress install. Run via `composer test`.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
	bootstrap="tests/php/bootstrap.php"
	colors="true"
	failOnWarning="true"
	failOnDeprecation="true"
	failOnNotice="true">
	<testsuites>
		<testsuite name="Solar Template">
			<directory>tests/php</directory>
		</testsuite>
	</testsuites>
	<source>
		<include>
			<directory>inc</directory>
		</include>
	</source>
</phpunit>
