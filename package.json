{
    "name": "solar-template",
    "version": "0.6.2",
    "private": true,
    "description": "Asset build pipeline (SCSS + JS) for the Solar Template WordPress theme.",
    "type": "module",
    "scripts": {
        "dev": "vite build --watch --mode development",
        "build": "vite build --mode production",
        "format": "prettier --write \"assets/**/*.{js,scss}\" \"tests/js/**/*.js\" \"vite.config.js\"",
        "test": "vitest run"
    },
    "devDependencies": {
        "jsdom": "^25.0.1",
        "prettier": "^3.3.3",
        "sass": "^1.80.0",
        "vite": "^8.0.0",
        "vitest": "^5.0.1"
    }
}
