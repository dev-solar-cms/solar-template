{
  "name": "dev-solar-cms/solar-template",
  "description": "Thème Wordpress + WooCommerce complet prémium.",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "version": "0.7.1",
  "require": {
    "php": ">=8.1",
    "vlucas/phpdotenv": "^5.6",
    "gettext/gettext": "^5.7"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Solar_Template\\": "inc/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solar_Template\\Tests\\": "tests/php/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "format": "phpcbf",
    "test": "phpunit"
  }
}
